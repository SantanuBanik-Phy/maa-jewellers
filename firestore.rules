rules_version = '2';

// Maa Jewellers — Firestore security rules
// Paste into Firebase console → Firestore Database → Rules → Publish.
// Only the admin (verified email below) can change prices, products, settings and order status.
// Customers can create orders, read the status of an order whose ID they know, and — when signed in —
// read their own orders and their own profile (users/{uid}).

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'santanubanik2k@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function customerStatus() {
      return ['Pending', 'Cash at shop', 'Not paid', 'Awaiting payment', 'Cash on delivery'];
    }

    // BAJUS rates + shop settings: everyone reads, only admin writes
    match /public/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /rateHistory/{id} {
      allow read, write: if isAdmin();
    }

    // Catalogue: everyone reads, only admin writes
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Full orders (customer name, phone, address): only admin can read
    match /orders/{id} {
      allow create: if isAdmin() || (
        id.matches('^MJ-[0-9]{6}-[0-9]{6}-[A-Z0-9]{4}$')
        && request.resource.data.id == id
        && request.resource.data.status in customerStatus()
        && request.resource.data.source == 'web'
        && request.resource.data.grand is number && request.resource.data.grand > 0
        && request.resource.data.items is list && request.resource.data.items.size() <= 30
        && (!('uid' in request.resource.data) || (request.auth != null && request.resource.data.uid == request.auth.uid))
        && request.resource.data.keys().hasOnly(['id', 'createdAt', 'lang', 'rateDate', 'rates', 'making',
             'customer', 'items', 'totals', 'grand', 'pay', 'status', 'lockUntil', 'source', 'delivery', 'plan', 'uid'])
      );
      // a signed-in customer can read the orders placed from their account
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Customer profile: only the owner (and the admin) can read it; only the owner writes it
    match /users/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'phone', 'addr', 'email', 'wish', 'photo', 'provider', 'createdAt', 'updatedAt'])
        && (!('wish' in request.resource.data) || (request.resource.data.wish is list && request.resource.data.wish.size() <= 100));
      allow delete: if isAdmin();
    }

    // Public order status (no personal data) — for live tracking
    match /orderStatus/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.status in customerStatus()
        && request.resource.data.keys().hasOnly(['status', 'updatedAt', 'method', 'paid', 'due', 'grand'])
      );
      allow update, delete: if isAdmin();
    }

    // Payment SMS forwarded from the shop phone (bKash / Nagad / bank). Written only by the server
    // (api/sms with the service account); the admin can read the log.
    match /smsPay/{trxId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // One document per used TrxID — create-only, so the same TrxID can never be used twice
    match /trx/{trxId} {
      allow get: if true;
      allow create: if trxId.matches('^[A-Z0-9]{6,20}$')
        && request.resource.data.keys().hasOnly(['order', 'at']);
      allow delete: if isAdmin();
    }
  }
}
